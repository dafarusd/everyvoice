<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!--
        A speech bubble that is making a sound.

        The bubble alone, with two lines of text in it, is the universal glyph
        for a text message — which is the opposite of what this app does. The
        speaker and the waves are the part that says "this speaks out loud".
    -->
    <path
        android:fillColor="#1A56DB"
        android:pathData="M10,4 L38,4 C41.3,4 44,6.7 44,10 L44,30 C44,33.3 41.3,36 38,36 L22,36 L12,44 L12,36 L10,36 C6.7,36 4,33.3 4,30 L4,10 C4,6.7 6.7,4 10,4 Z" />

    <!-- Speaker cone. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M15,17.5 L18.5,17.5 L22.5,13.5 L22.5,26.5 L18.5,22.5 L15,22.5 Z" />

    <!-- Two sound waves. -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M25.5,16.6 A5.2,5.2 0 0 1 25.5,23.4" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M28.4,13.9 A9,9 0 0 1 28.4,26.1" />
</vector>
